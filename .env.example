# Copy to .env.local and fill in. NEVER commit .env.local. Everything below is free (no card).

# --- Database: Neon Postgres (free tier) ---
# neon.tech → New project "allowance" → Connect → copy the *pooled* connection string
# Local development should use a Neon *branch* (e.g. "dev") so tests don't touch live data.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Live database (main branch), only used by `npm run db:push:prod` / `db:seed:prod`.
PROD_DATABASE_URL=

# --- PayPal (SANDBOX ONLY) ---
# developer.paypal.com → Apps & Credentials → Sandbox → "Allowance" app → Client ID / Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Created in M4: Apps & Credentials → Allowance → Sandbox Webhooks → Add webhook → copy Webhook ID
PAYPAL_WEBHOOK_ID=
# developer.paypal.com → Testing Tools → Sandbox Accounts → the *second* business account (demo store)
# This is who receives Payouts after an agent purchase is captured.
STORE_PAYPAL_EMAIL=

# --- App ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=
APP_URL=http://localhost:3100

# --- Payout settlement window ---
# Merchant payouts are held this many seconds after capture so a refund can cancel them.
PAYOUT_HOLD_SECONDS=900
# Shorter hold for demo accounts so judges see the payout land quickly.
DEMO_PAYOUT_HOLD_SECONDS=20
# Protects /api/cron/payouts. Generate with: openssl rand -hex 32 (Vercel Cron sends it automatically)
CRON_SECRET=

# --- Judge demo mode ---
# Link the sandbox personal buyer once (Link PayPal page), then copy that row's payment_token_id here.
# Every "Try the demo" account charges this shared sandbox buyer, so judges skip the PayPal login.
DEMO_PAYMENT_TOKEN_ID=
DEMO_PAYER_EMAIL=

# --- AI (M5) ---
# google (default) or groq
AI_PROVIDER=google
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# AI_DAILY_LIMIT=800
# aistudio.google.com → Get API key (free tier, no card)
GOOGLE_GENERATIVE_AI_API_KEY=
# console.groq.com → API Keys (free tier, no card) — fallback provider
GROQ_API_KEY=

# --- AG Studio (merchant analytics at /store/analytics) ---
# Request the free 45-day trial: https://www.ag-grid.com/studio/react/enterprise-licence/#request-a-45-day-trial-licence
# Without a key the dashboard still works, with a watermark and console warnings.
AG_STUDIO_LICENSE_KEY=

# --- Telegram approvals (M4) ---
# Telegram → @BotFather → /newbot → copy token
TELEGRAM_BOT_TOKEN=
# Any random string (openssl rand -hex 16); used to verify Telegram webhook calls
TELEGRAM_WEBHOOK_SECRET=

# ES256 private key that signs AP2-style mandates and purchase receipts (public key: /.well-known/jwks.json).
# Generate: node -e 'const {generateKeyPairSync}=require("crypto");console.log(generateKeyPairSync("ec",{namedCurve:"P-256"}).privateKey.export({type:"pkcs8",format:"pem"}).trim().replace(/\n/g,"\\n"))'
MANDATE_SIGNING_KEY=
