# Copy to .env.local and fill in. NEVER commit .env.local. Everything below is free (no card).

# --- Database: Neon Postgres (free tier) ---
# neon.tech → New project "allowance" → Connect → copy the *pooled* connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- PayPal (SANDBOX ONLY) ---
# developer.paypal.com → Apps & Credentials → Sandbox → "Allowance" app → Client ID / Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Created in M4: Apps & Credentials → Allowance → Sandbox Webhooks → Add webhook → copy Webhook ID
PAYPAL_WEBHOOK_ID=
# developer.paypal.com → Testing Tools → Sandbox Accounts → the *second* business account (demo store)
# This is who receives Payouts after an agent purchase is captured.
STORE_PAYPAL_EMAIL=

# --- App ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=
APP_URL=http://localhost:3100

# --- Payout settlement window ---
# Merchant payouts are held this many seconds after capture so a refund can cancel them.
PAYOUT_HOLD_SECONDS=900
# Shorter hold for demo accounts so judges see the payout land quickly.
DEMO_PAYOUT_HOLD_SECONDS=20
# Protects /api/cron/payouts. Generate with: openssl rand -hex 32 (Vercel Cron sends it automatically)
CRON_SECRET=

# --- AI (M5) ---
# google (default) or groq
AI_PROVIDER=google
# aistudio.google.com → Get API key (free tier, no card)
GOOGLE_GENERATIVE_AI_API_KEY=
# console.groq.com → API Keys (free tier, no card) — fallback provider
GROQ_API_KEY=

# --- Telegram approvals (M4) ---
# Telegram → @BotFather → /newbot → copy token
TELEGRAM_BOT_TOKEN=
# Any random string (openssl rand -hex 16); used to verify Telegram webhook calls
TELEGRAM_WEBHOOK_SECRET=
