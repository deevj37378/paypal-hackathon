{
  "name": "allowance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:push:prod": "DRIZZLE_TARGET=prod drizzle-kit push",
    "db:seed:prod": "node scripts/with-prod-db.mjs tsx --env-file=.env.local scripts/seed.ts",
    "catalog:sync": "tsx --env-file=.env.local scripts/sync-catalog.ts",
    "catalog:sync:prod": "node scripts/with-prod-db.mjs tsx --env-file=.env.local scripts/sync-catalog.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.111",
    "@ai-sdk/groq": "^4.0.76",
    "@ai-sdk/provider": "^4.0.35",
    "@ai-sdk/react": "^4.0.166",
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.162",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "mcp-handler": "^2.3.0",
    "nanoid": "^6.0.2",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
